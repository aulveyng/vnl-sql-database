CREATE OR REPLACE VIEW public.match_team_stats_wide
 AS
 SELECT m.match_id,
    m.week,
    m.match_date,
    m.team_a,
    m.team_b,
    m.winner,
    m.team_a_sets,
    m.team_b_sets,
    a.total_points AS team_a_points,
    a.total_break_points AS team_a_break_points,
    a.total_pts_bp_ratio AS team_a_pts_bp_ratio,
    a.total_serve_attempts AS team_a_serve_attempts,
    a.total_serve_errors AS team_a_serve_errors,
    a.total_serve_aces AS team_a_serve_aces,
    a.total_serve_efficiency AS team_a_serve_efficiency,
    a.total_reception_attempts AS team_a_reception_attempts,
    a.total_reception_errors AS team_a_reception_errors,
    a.total_reception_positive_per AS team_a_reception_positive_per,
    a.total_reception_perf_per AS team_a_reception_perf_per,
    a.total_attack_attempts AS team_a_attack_attempts,
    a.total_attack_errors AS team_a_attack_errors,
    a.total_attack_blocked AS team_a_attack_blocked,
    a.total_attack_kills AS team_a_attack_kills,
    a.total_attack_kills_per AS team_a_attack_kills_per,
    a.total_attack_efficiency AS team_a_attack_efficiency,
    a.total_block_pts AS team_a_block_pts,
    a.total_block_touches AS team_a_block_touches,
    a.total_digs AS team_a_digs,
    a.total_assists AS team_a_assists,
    b.total_points AS team_b_points,
    b.total_break_points AS team_b_break_points,
    b.total_pts_bp_ratio AS team_b_pts_bp_ratio,
    b.total_serve_attempts AS team_b_serve_attempts,
    b.total_serve_errors AS team_b_serve_errors,
    b.total_serve_aces AS team_b_serve_aces,
    b.total_serve_efficiency AS team_b_serve_efficiency,
    b.total_reception_attempts AS team_b_reception_attempts,
    b.total_reception_errors AS team_b_reception_errors,
    b.total_reception_positive_per AS team_b_reception_positive_per,
    b.total_reception_perf_per AS team_b_reception_perf_per,
    b.total_attack_attempts AS team_b_attack_attempts,
    b.total_attack_errors AS team_b_attack_errors,
    b.total_attack_blocked AS team_b_attack_blocked,
    b.total_attack_kills AS team_b_attack_kills,
    b.total_attack_kills_per AS team_b_attack_kills_per,
    b.total_attack_efficiency AS team_b_attack_efficiency,
    b.total_block_pts AS team_b_block_pts,
    b.total_block_touches AS team_b_block_touches,
    b.total_digs AS team_b_digs,
    b.total_assists AS team_b_assists
   FROM matches m
     LEFT JOIN team_match_stats a ON m.match_id = a.match_id AND m.team_a = a.team_id
     LEFT JOIN team_match_stats b ON m.match_id = b.match_id AND m.team_b = b.team_id;

ALTER TABLE public.match_team_stats_wide
    OWNER TO neondb_owner;

